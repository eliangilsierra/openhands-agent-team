#!/bin/sh
# commit-msg: Conventional Commits subject (72 characters at most), no Co-Authored-By trailers, and no
# secrets or private data in the message, which is published with the commit (Issue #15).
# Installed through core.hooksPath for every repository the agents touch (see docs/subagents.md).
# shellcheck source-path=SCRIPTDIR source=scan-lib.sh
. "$(dirname "$0")/scan-lib.sh"
msg_file="$1"
subject="$(sed -n '1p' "$msg_file")"

body=$(mktemp)
trap 'rm -f "$body"' EXIT
# Comment lines are not part of the message; sign-off style trailers carry the author's own address.
grep -v '^#' "$msg_file" | grep -Ev '^[A-Za-z-]+-[Bb]y: ' > "$body"
found=$(team_scan_file "$body" "secret private")
case $? in
  1)
    echo "commit-msg: the message contains $found; commit messages are public, so redact them" >&2
    exit 1
    ;;
  2) exit 1 ;;
esac

case "$subject" in
  "Merge "*) exit 0 ;; # merging main into a working branch; squash merge removes it
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [a-z0-9].*[^. ]$"; then
  echo "commit-msg: the subject must follow Conventional Commits: <type>(<scope>): <description>" >&2
  echo "commit-msg: got: $subject" >&2
  exit 1
fi
if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: the subject is longer than 72 characters" >&2
  exit 1
fi
if grep -Eiq '^co-authored-by:' "$msg_file"; then
  echo "commit-msg: Co-Authored-By trailers are not allowed; the runtime sets the identity" >&2
  exit 1
fi
exit 0
