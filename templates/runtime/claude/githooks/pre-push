#!/bin/sh
# pre-push: never push main or master, enforce branch names, and scan the pushed commits for secrets.
zero=0000000000000000000000000000000000000000
pattern='^(feature|bugfix|refactor|chore|docs)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'
secrets='gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,}|sk-ant-[A-Za-z0-9_-]{20,}|(AKIA|ASIA)[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    main|master)
      echo "pre-push: nobody pushes to $branch; open a pull request" >&2
      status=1
      continue
      ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    continue # deleting a remote branch
  fi
  if ! printf '%s\n' "$branch" | grep -Eq "$pattern"; then
    echo "pre-push: branch '$branch' must match <feature|bugfix|refactor|chore|docs>/<issue-number>-<short-description>" >&2
    status=1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086 # range is intentionally split into git arguments
  if git log -p $range 2>/dev/null | grep -Eq "^\+.*($secrets)"; then
    echo "pre-push: a pushed commit adds something that looks like a secret; remove it and rotate the credential" >&2
    status=1
  fi
done
exit "$status"
