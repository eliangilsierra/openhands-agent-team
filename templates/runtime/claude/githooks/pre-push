#!/bin/sh
# pre-push: never push main or master, enforce branch names, and scan the pushed commits for secrets
# with the team policy (Issue #15).
# shellcheck source-path=SCRIPTDIR source=scan-lib.sh
. "$(dirname "$0")/scan-lib.sh"
zero=0000000000000000000000000000000000000000
pattern='^(feature|bugfix|refactor|chore|docs)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'
status=0
added=$(mktemp)
trap 'rm -f "$added"' EXIT

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    main|master)
      echo "pre-push: nobody pushes to $branch; open a pull request" >&2
      status=1
      continue
      ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    continue # deleting a remote branch
  fi
  if ! printf '%s\n' "$branch" | grep -Eq "$pattern"; then
    echo "pre-push: branch '$branch' must match <feature|bugfix|refactor|chore|docs>/<issue-number>-<short-description>" >&2
    status=1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086 # range is intentionally split into git arguments
  git log -p --no-color $range 2>/dev/null | grep '^+' | grep -v '^+++ ' | sed 's/^+//' > "$added"
  found=$(team_scan_file "$added" secret)
  case $? in
    1)
      echo "pre-push: a pushed commit adds something that looks like a secret ($found); remove it and rotate the credential" >&2
      status=1
      ;;
    2) status=1 ;;
  esac
  if team_gitleaks_enabled && ! gitleaks git --log-opts="$range" --redact --no-banner >&2; then
    echo "pre-push: gitleaks reported a finding in the pushed commits" >&2
    status=1
  fi
done
exit "$status"
