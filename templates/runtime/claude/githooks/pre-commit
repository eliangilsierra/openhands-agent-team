#!/bin/sh
# pre-commit: block staged secrets, secret-bearing files, files over 1 MB and conflict markers (Issue #15).
# shellcheck source-path=SCRIPTDIR source=scan-lib.sh
. "$(dirname "$0")/scan-lib.sh"

max_bytes=1048576
status=0
added=$(mktemp)
trap 'rm -f "$added"' EXIT

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

old_ifs=$IFS
IFS='
'
for file in $files; do
  if team_secret_file "$file"; then
    echo "pre-commit: $file is a secret-bearing file type and is never committed" >&2
    status=1
  fi
  size=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    echo "pre-commit: $file is $((size / 1024)) KiB; generated artefacts and binaries do not belong in the repository" >&2
    status=1
  fi
done
IFS=$old_ifs

git diff --cached --no-color --unified=0 --diff-filter=ACMR | grep '^+' | grep -v '^+++ ' | sed 's/^+//' > "$added"

if grep -Eq '^(<<<<<<<|>>>>>>>)( |$)' "$added"; then
  echo "pre-commit: unresolved merge conflict markers are staged" >&2
  status=1
fi

found=$(team_scan_file "$added" secret)
case $? in
  1)
    echo "pre-commit: the staged changes contain what looks like a secret ($found). Remove it, use an environment variable or a placeholder, and rotate the credential if it was real." >&2
    status=1
    ;;
  2) status=1 ;;
esac

if team_gitleaks_enabled && ! gitleaks git --pre-commit --staged --redact --no-banner >&2; then
  echo "pre-commit: gitleaks reported a finding" >&2
  status=1
fi
exit "$status"
